# Local API port only. On Hostinger, delete PORT.
# Hostinger assigns the port. Saving 3000 or 5000 makes the live site return 503.
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/latitude
FRONTEND_ORIGIN=https://interiorlord.com,https://www.interiorlord.com

# Gmail that receives inquiries and sends the thank-you.
# MAIL_PASS is a Google App Password, not the Gmail login password.
# Google Account → Security → 2-Step Verification → App passwords → Mail.
MAIL_USER=interiorlord.official@gmail.com
MAIL_PASS=
MAIL_TO=interiorlord.official@gmail.com

# Password for the private lead page at /crm
CRM_PASSWORD=
