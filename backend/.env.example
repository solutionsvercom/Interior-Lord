# Local API port only. On Hostinger, delete PORT.
# Hostinger assigns the port. Saving 3000 or 5000 makes the live site return 503.
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/latitude
FRONTEND_ORIGIN=https://interiorlord.com,https://www.interiorlord.com
