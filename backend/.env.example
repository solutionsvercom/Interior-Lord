# Local API port only. On Hostinger, delete PORT or set it to 3000.
# Leaving 5000 makes interiorlord.com return 504 Gateway Timeout.
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/latitude
FRONTEND_ORIGIN=https://interiorlord.com,https://www.interiorlord.com
